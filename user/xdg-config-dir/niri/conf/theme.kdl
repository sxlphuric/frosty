layout {
    center-focused-column never
    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.75
    }
    default-column-width {
        proportion 0.5
    }
    background-color transparent
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
    struts {

    }
}
overview {
    workspace-shadow {
        on
    }
}
cursor {
    xcursor-theme Bibata-Modern-Ice
    xcursor-size 48
}
