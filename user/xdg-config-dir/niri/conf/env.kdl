environment {
  QT_IM_MODULE "fcitx"
  XMODIFIERS "@im=fcitx"
  SDL_IM_MODULE "fcitx"
  GLFW_IM_MODULE "ibus"
  INPUT_METHOD "fcitx"

  ELECTRON_OZONE_PLATFORM_HINT "wayland"
  
  QT_QPA_PLATFORM "wayland"
  QT_QPA_PLATFORMTHEME "qt6ct"
  QT_QPA_PLATFORMTHEME_QT6 "qt6ct"
  XDG_MENU_PREFIX "plasma-"

  TERMINAL "kitty -1"
  TERM "xterm-kitty"
  SHELL "/usr/bin/fish"
  EDITOR "nvim"
  LANG "en_US.UTF-8"

  DMS_MODAL_LAYER "overlay"
  DMS_POPOUT_LAYER "overlay"
  DMS_SCREENSHOT_EDITOR "satty"
  DMS_HIDE_TRAYIDS "kalarm,kgpg,nm-applet,zero-trust-client"

  XCURSOR_THEME "Bibata-Modern-Ice"
  XCURSOR_SIZE "24"

  XDG_CURRENT_DESKTOP "niri:GNOME"
  XDG_MENU_PREFIX "gnome-"
  BROWSER "dms-open.desktop"
}
