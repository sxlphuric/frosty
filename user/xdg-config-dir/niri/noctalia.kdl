layout {

    focus-ring {
        active-color   "#00658d"
        inactive-color "#f9f9fc"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#00658d"
        inactive-color "#f9f9fc"
        urgent-color   "#ba1a1a"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#00658d"
        inactive-color "#c6e7ff"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#00658d80"
    }
}

recent-windows {
    highlight {
        active-color "#00658d"
        urgent-color "#ba1a1a"
    }
}
