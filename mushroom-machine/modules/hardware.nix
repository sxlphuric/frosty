          "k:18d1:5057"
          "k:18d1:503c"
          "k:18d1:5050"
          "k:18d1:5030" ];
        settings = {
          main = {
            f1 = "back";
            f2 = "refresh";
            f3 = "f11";
            f4 = "scale";
