{lib, ...}:{
  hardware.bluetooth = {
    enable = true;
    powerOnBoot = true;
    settings = {
      General = {
        Experimental = true;
        FastConnectable = true;
      };
      Policy = {
        AutoEnable = true;
      };
    };
  };

  environment.etc."libinput/local-overrides.quirks".text = lib.mkForce ''
    [keyd virtual keyboard]
    MatchName=keyd virtual keyboard
    AttrKeyboardIntegration=internal
    ModelTabletModeNoSuspend=1
  '';

  services.keyd = {
    # Configuration translated from cros.conf generated by WeirdTreeThing's script
    # Only for Jasper Lake!
    enable = true;
    keyboards = {
      cros = {
        ids = [ "k:18d1:502b"
